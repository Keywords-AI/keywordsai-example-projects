# Generation — pick ONE:
#
# Option A (recommended for this project): Respan Gateway.
#   Routes to Claude AND logs every call in Respan. No ANTHROPIC_API_KEY needed.
RESPAN_API_KEY=sk-respan-...
# RESPAN_GATEWAY_URL=https://api.respan.ai/api/anthropic/   # default; rarely changed
#
# Option B: Anthropic directly (only used if RESPAN_API_KEY is unset).
# ANTHROPIC_API_KEY=sk-ant-...

# Optional: layout-aware PDF parsing (recommended for textbooks).
# Get a free key at https://cloud.llamaindex.ai . If unset, a built-in PDF
# reader is used instead.
# LLAMA_CLOUD_API_KEY=llx-...

# --- Generation ---
# GENERATION_MODEL=claude-opus-4-8   # or claude-sonnet-5 / claude-haiku-4-5 for cheaper/faster
# THINKING=adaptive                  # `adaptive` (default) or `off`. Derived per model,
#                                    # so pre-4.6 models simply run without it.

# --- Conversation memory ---
# HISTORY_TURNS=6                    # prior chat turns replayed into each answer; 0 = no memory
# REWRITE_MODEL=claude-haiku-4-5     # rewrites follow-ups into standalone retrieval queries

# --- Retrieval and chunking ---
# Source-diverse retrieval: pull TOP_K_PER_BOOK from every book in the subject,
# merge, then keep the best MAX_CONTEXT_CHUNKS overall, so a weaker book still
# gets a seat and answers can synthesize across sources.
# TOP_K_PER_BOOK=8
# MAX_CONTEXT_CHUNKS=14
# EMBED_MODEL=BAAI/bge-small-en-v1.5
# CHUNK_SIZE=800
# CHUNK_OVERLAP=150

# Lecture mode pulls the chunks either side of each hit, in reading order, so the
# tutor gets a continuous run of the book instead of disconnected fragments.
# LECTURE_NEIGHBOUR_WINDOW=1
# LECTURE_MAX_CHUNKS=18

# --- Retrieval experiments (both off by default) ---
# Flip one on, re-run the matching script in scripts/, and compare before
# committing to it. Neither is currently a win at TOP_K_PER_BOOK=8.
#
# Hybrid: fuse dense vector search with BM25 keyword search by Reciprocal Rank
# Fusion, per book. Helps on exact notation that embeddings blur.
# HYBRID_SEARCH=off
# RRF_K=60                           # rank-fusion damping; 60 is standard
# HYBRID_CANDIDATES=20               # pool per method before fusion
#
# Rerank: a local cross-encoder reorders a larger candidate pool before the
# TOP_K_PER_BOOK cut. Targets recall@1 / MRR. Downloads once, no API key.
# RERANK=off
# RERANK_MODEL=BAAI/bge-reranker-base
# RERANK_CANDIDATES=20               # pool fetched, then reranked down

# --- Figure and exercise captioning ---
# CAPTION_IMAGES=true
# CAPTION_MODEL=claude-haiku-4-5     # OCR-shaped work, so it does not inherit
#                                    # GENERATION_MODEL; Opus cost ~5x for no gain.

# --- Respan graders and pipelines (workspace-specific) ---
# Don't fill these in by hand. The ids don't exist until the objects are created
# in your workspace, so provision them and let the script write the ids back:
#
#     python -m scripts.setup_respan            # dry run
#     python -m scripts.setup_respan --apply    # create, then fill in below
#
# (Or run the /setup-respan skill, which does the same thing from Claude Code.)
# Used only by `python -m scripts.run_experiment` and the Inspect panel's
# Evaluate button — the app never grades anything on its own.

# PIPELINE ids: each pipeline's `workflow_id`, the stable family id, NOT the
# `id` field. Every commit mints a new `id`, so pinning that freezes the grader
# at today's version while the platform happily reports a newer one deployed.
# Read by backend/config.py.
# EVAL_PIPELINE_CONTEXT_RELEVANCE=
# EVAL_PIPELINE_CONTEXT_COMPLETENESS=
# EVAL_PIPELINE_GROUNDEDNESS=
# EVAL_PIPELINE_CONTEXT_UTILIZATION=
# EVAL_PIPELINE_CITATION_VALIDITY=

# GRADER ids, which are a different thing from the pipeline ids above. Read only
# by `python -m scripts.check_graders`, to diff the live grader against the
# definition shipped in graders.json.
# EVAL_ID_CONTEXT_RELEVANCE=
# EVAL_ID_CONTEXT_COMPLETENESS=
# EVAL_ID_GROUNDEDNESS=
# EVAL_ID_CONTEXT_UTILIZATION=
# EVAL_ID_CITATION_VALIDITY=

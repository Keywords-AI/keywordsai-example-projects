# Respan export settings. The examples load ../../.env first.
RESPAN_API_KEY="your-respan-api-key"
RESPAN_BASE_URL="https://api.respan.ai/api"

# Optional: point examples at a real Dify API-compatible endpoint.
# When omitted, examples start a local Dify-compatible test server.
# DIFY_BASE_URL="https://api.dify.ai/v1"
# DIFY_API_KEY="your-dify-api-key"
# DIFY_CHAT_API_KEY="your-chat-app-key"
# DIFY_COMPLETION_API_KEY="your-completion-app-key"
# DIFY_WORKFLOW_API_KEY="your-workflow-app-key"

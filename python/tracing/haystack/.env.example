# Required for exporting traces and for gateway examples.
RESPAN_API_KEY=your_respan_api_key_here

# Optional. Defaults to https://api.respan.ai/api.
# RESPAN_BASE_URL=https://api.respan.ai/api

# Optional for direct OpenAI examples that do not use the Respan gateway.
# OPENAI_API_KEY=your_openai_api_key_here

# Required for 43_prompt_management_gateway.py.
# Create and deploy a Respan prompt with variables named question and context.
# RESPAN_PROMPT_ID=your_deployed_prompt_id_here

# Optional prompt variable overrides for 43_prompt_management_gateway.py.
# Use RESPAN_PROMPT_VARIABLES_JSON when your managed prompt uses different
# variable names than question/context.
# RESPAN_PROMPT_VARIABLES_JSON={"user_query":"How can I reset my password?"}
# RESPAN_PROMPT_QUESTION=Who created Python?
# RESPAN_PROMPT_CONTEXT=Python was created by Guido van Rossum and first released in 1991.

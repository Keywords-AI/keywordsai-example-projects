# Required: your Respan API key (LLM calls are routed through Respan; no OpenAI key needed)
RESPAN_API_KEY=your_respan_api_key_here

# Optional: override the Respan base URL (default: https://api.respan.ai/api)
# RESPAN_BASE_URL=https://api.respan.ai/api

# Optional: override the Claude model used by 06_anthropic.py through the gateway
# PYDANTIC_AI_ANTHROPIC_GATEWAY_MODEL=claude-sonnet-4-5-20250929
